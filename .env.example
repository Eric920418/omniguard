# Copy to .env, then fill in local secrets. Never commit .env.
GATEWAY_TOKEN=
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com
SEMANTIC_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Empty uses the GMI vision model when GMI_API_KEY is set.
VISION_MODEL=
# Optional independent vision provider; otherwise reuses GMI_API_KEY.
VISION_API_KEY=
VISION_BASE_URL=
# Optional application upstream; empty key keeps local demo completions.
UPSTREAM_API_KEY=
UPSTREAM_BASE_URL=https://api.gmi-serving.com
